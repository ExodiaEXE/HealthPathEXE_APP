# ===================================================================
# HealthPath Mobile — file cấu hình môi trường
# ===================================================================
# 1. copy .env.example .env
# 2. Sửa giá trị — KHÔNG commit file `.env`
# ===================================================================

# --- Backend API ---
# Android Emulator: https://10.0.2.2:7232
API_BASE_URL=https://10.0.2.2:7232
# API_BASE_URL=http://10.0.2.2:5048
# Để trống = chế độ offline/mock UI
# API_BASE_URL=

JWT_ISSUER=healthpath

# ===================================================================
# GOOGLE ĐĂNG NHẬP
# ===================================================================
# Lấy từ: https://console.cloud.google.com/apis/credentials
#
# 1. Tạo OAuth Client loại **Web application**
#    → copy Client ID vào GOOGLE_CLIENT_ID (dùng làm serverClientId lấy id_token)
# 2. Tạo OAuth Client loại **Android**
#    - Package name: com.example.health
#    - SHA-1: chạy  keytool -list -v -keystore %USERPROFILE%\.android\debug.keystore -alias androiddebugkey -storepass android -keypass android
# 3. (iOS) Tạo OAuth Client loại **iOS**
#    - Bundle ID: com.example.health (hoặc bundle thật của bạn)
#    - Thêm vào ios/Runner/Info.plist:
#        CFBundleURLTypes → URL scheme = REVERSED_CLIENT_ID (vd com.googleusercontent.apps.123...)
#        GIDClientID = iOS Client ID
#
# Để trống GOOGLE_CLIENT_ID → app dùng mock token (chỉ khi backend Development + AllowMockTokens=true)
GOOGLE_CLIENT_ID=

# ===================================================================
# FACEBOOK ĐĂNG NHẬP
# ===================================================================
# Lấy từ: https://developers.facebook.com/apps
#
# 1. Tạo app → thêm sản phẩm **Facebook Login**
# 2. App ID → FACEBOOK_APP_ID
# 3. Settings → Advanced → Client token → FACEBOOK_CLIENT_TOKEN
# 4. Android: sửa android/app/src/main/res/values/strings.xml
#      facebook_app_id, fb_login_protocol_scheme (fb + AppID), facebook_client_token
# 5. iOS: sửa ios/Runner/Info.plist
#      FacebookAppID, FacebookClientToken, CFBundleURLSchemes = fb{AppID}
# 6. Facebook Login → Settings → Valid OAuth Redirect URIs (nếu cần)
#
# Để trống → mock Facebook (backend Development)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# --- Push FCM (tùy chọn) ---
# google-services.json → health/android/app/google-services.json
# Backend: Firebase__CredentialPath trong health_backend/.env
