# ===================================================================
# HealthPath Mobile — file cấu hình môi trường (giống health_backend/.env)
# ===================================================================
# 1. Copy file này thành `.env` (cùng thư mục):
#      copy .env.example .env
#    hoặc chạy:  .\scripts\setup_env.ps1
#
# 2. Sửa giá trị bên dưới cho đúng máy bạn — KHÔNG commit file `.env`
#
# 3. Chạy app bình thường từ Android Studio (F5) — không cần --dart-define
# ===================================================================

# Backend API (Visual Studio F5 thường là https://localhost:7232)
# Android Emulator dùng 10.0.2.2 thay cho localhost:
API_BASE_URL=https://10.0.2.2:7232

# Nếu chạy profile HTTP của backend (cổng 5048):
# API_BASE_URL=http://10.0.2.2:5048

# Để chạy demo offline (không gọi API), để trống:
# API_BASE_URL=

JWT_ISSUER=healthpath

# OAuth (để trống nếu dùng mock social login)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=

# Push notification (FCM) — tùy chọn:
# 1. Tạo Firebase project, thêm app Android (com.example.health)
# 2. Tải google-services.json → health/android/app/google-services.json
# 3. Backend: đặt firebase-service-account.json + Firebase__CredentialPath trong .env
# Không có google-services.json → app vẫn chạy, chỉ thiếu push khi app đóng/kill.
